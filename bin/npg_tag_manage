#!/usr/bin/env perl

use strict;
use warnings;
use FindBin qw($Bin);
use lib ( -d "$Bin/../lib/perl5" ? "$Bin/../lib/perl5" : "$Bin/../lib" );

use npg_tracking::tag_manager;

npg_tracking::tag_manager->new_with_options()->perform_action();

0;

__END__

=head1 NAME

npg_tag_manage

=head1 USAGE

  # Add a single tag
  npg_tag_manage --id_run 1234 --tag 'staging' --username pipeline

  # Add multiple tags
  npg_tag_manage --id_run 1234 --tag 'no auto' --tag 'staging' --username pipeline

  # Remove a single tag
  npg_tag_manage --id_run 1234 --tag 'staging' --rm

  # Remove multiple tags
  npg_tag_manage --id_run 1234 --tag 'staging' --tag 'no auto' --rm

=head1 REQUIRED ARGUMENTS

 id_run - tracking run ID

 tag - a single tag, might be specified several times

=head1 OPTIONS

 rm - a boolean flag, switches the script from adding (default,
      the option value is false) to removing the tags

 username - the name of the user for the database record, required for
            adding tags

=head1 EXIT STATUS

 0

=head1 CONFIGURATION

=head1 DESCRIPTION

 A script to add or remove a tag or tags for a tracked NPG sequencing run.

 If the database operation fails for one of the tags, all changes are rolled back,
 the exit code of the script is non-zero.

 Adding a tag the run already has or removing a tag the run does not have does
 not cause an error.

=head1 DIAGNOSTICS

=head1 CONFIGURATION AND ENVIRONMENT

=head1 DEPENDENCIES

=over

=item strict

=item warnings

=item npg_pipeline::tag_manager

=item FindBin

=item lib

=back

